{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "swan-server",
      "runtimeExecutable": "app/server/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "main:app", "--app-dir", "app/server", "--port", "8000", "--reload", "--reload-dir", "app/server"],
      "port": 8000
    },
    {
      "name": "swan-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "app/web", "run", "dev"],
      "port": 5173
    }
  ]
}
